# Relay configuration. In CI these come from the workflow and from repository
# secrets; this file is for running a tick locally.

# GenLayer side: where the bridge sender is read from. The Studio API routes by
# chain id, so GENLAYER_CHAIN_ID must match the node or it answers with HTML.
GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
GENLAYER_CHAIN_ID=61997
BRIDGE_SENDER_ADDRESS=0xffe709e5883f5E669D4aBa35d0544269b28ce3d4

# EVM side: the forwarder the message is pushed to.
FORWARDER_NETWORK_RPC_URL=https://sepolia.era.zksync.dev
BRIDGE_FORWARDER_ADDRESS=0xBCa1b17E4e392A7104f964a8426b7c3f945f288d

# Relayer bot key. Needs CALLER_ROLE on the forwarder and gas on ZKsync Sepolia.
PRIVATE_KEY=
