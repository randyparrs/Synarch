# Signing keys for the operational scripts. Copy to .env and fill in.
# .env is git-ignored: never commit a real key.

# Deployer / client wallet. Owns the GenLayer contracts and funds the escrow.
PRIVATE_KEY=

# One key per agent: each agent registers and configures itself, so ownership
# (and therefore the fault-based payout split) is real rather than simulated.
DATA_AGENT_PK=
ANALYST_PK=
RESEARCHER_PK=
STRATEGIST_PK=

# GenLayer Studio Next (chain 61997).
GENLAYER_RPC_URL=https://studio-next.genlayer.com/api

# Deployed addresses, also hardcoded in e2e-common.ts.
BRIDGE_SENDER_ADDRESS=0xffe709e5883f5E669D4aBa35d0544269b28ce3d4
TARGET_CHAIN_EID=40245
